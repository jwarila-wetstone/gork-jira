class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        conn = db()
        if u.path == "/":
            self.send(200, PAGE, "text/html")
        elif u.path == "/api/board":
            self.send(200, json.dumps(board(conn), default=str))
        elif u.path == "/api/efforts":
            self.send(200, json.dumps(load(conn, "closed" in q), default=str))
        else:
            self.send(404, '{"error":"not found"}')

    def do_POST(self):
        # Only accept same-origin JSON: blocks drive-by form posts from other sites.
        if self.headers.get("Content-Type", "").split(";")[0] != "application/json":
            return self.send(415, '{"error":"json only"}')
        n = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(n) or b"{}")
        conn = db()
        try:
            if self.path == "/api/sync":
                r = sync_all(conn)
                return self.send(200, json.dumps({k: r[k] for k in ("synced", "total")}))
            eid = int(body["id"])
            if self.path == "/api/status" and body.get("status") in STATUSES:
                touch(conn, eid, status=body["status"])
            elif self.path == "/api/note":
                touch(conn, eid, note=str(body.get("note", "")))
            elif self.path == "/api/pr":
                url = add_pr_checked(conn, eid, str(body.get("url", "")))
                sync_prs(conn, [url])
            else:
                return self.send(400, '{"error":"bad request"}')
            conn.commit()
            self.send(200, '{"ok":true}')
        except (KeyError, ValueError) as ex:
            self.send(400, json.dumps({"error": str(ex)}))


def add_pr_checked(conn, eid, url):
    if not PR_RE.search(url):
        raise ValueError("not a GitHub PR url")
    return add_pr(conn, eid, url)


def cmd_serve(args):
    conn = db()
    if not args.no_sync:
        def loop():
            while True:
                try:
                    sync_all(db())
                except Exception as ex:  # keep the dashboard up if gh hiccups
                    print("gj: sync failed: %s" % ex, file=sys.stderr)
                time.sleep(args.interval * 60)
        threading.Thread(target=loop, daemon=True).start()
    conn.close()
    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = "http://127.0.0.1:%d/" % args.port
    print("gj: dashboard at %s  (db: %s)" % (url, DB_PATH))
    if args.open:
        run(["open", url])
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------- install

MARK_BEGIN = "<!-- gj:begin -->"
MARK_END = "<!-- gj:end -->"
INSTRUCTIONS = MARK_BEGIN + """
## Effort tracking (gj)

The user tracks every line of work that leads to a PR with the `gj` CLI, so no PR is forgotten.
When a task will produce a pull request, do this without being asked:

1. Before you start, register it: `gj start "<short title>" --prompt "<the user's request, verbatim>"`
   (add `--epic "<name>"` if the user names a larger effort). Run it from the repo or worktree you work in.
   Run it once per session; running it again only updates the title.
2. Right after you open a PR: `gj pr <pr-url>`
3. If you get stuck waiting on the user: `gj status blocked --note "<what you need>"`.
   When the work is finished without a PR: `gj status done`.

`gj` detects the agent and session on its own. If a `gj` command fails, mention it once and keep working.
""" + MARK_END + "\n"

TARGETS = {
    "claude": HOME / ".claude/CLAUDE.md",
    "codex": HOME / ".codex/AGENTS.md",
    "grok": HOME / ".grok/AGENTS.md",
}


def cmd_install(args):
    for agent in args.agents or AGENTS:
        if agent not in TARGETS:
            sys.exit("gj: unknown agent %s" % agent)
        path = TARGETS[agent]
        if not path.parent.exists():
            print("gj: skip %s (%s missing)" % (agent, path.parent))
            continue
        text = path.read_text() if path.exists() else ""
        if MARK_BEGIN in text:
            text = re.sub(re.escape(MARK_BEGIN) + ".*?" + re.escape(MARK_END) + "\n?",
                          lambda m: INSTRUCTIONS, text, flags=re.S)
        elif args.uninstall:
            continue
        else:
            text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + INSTRUCTIONS
        if args.uninstall:
            text = text.replace(INSTRUCTIONS, "").rstrip("\n") + "\n"
        path.write_text(text)
        print("gj: %s %s" % ("removed from" if args.uninstall else "installed in", path))
        if agent == "codex":
            codex_sandbox(args.uninstall)


CODEX_BLOCK = '# gj:begin\n[sandbox_workspace_write]\nwritable_roots = [%s]\n# gj:end\n'


def codex_sandbox(uninstall):
    """Codex's default sandbox only writes inside the workspace; let it write the gj db."""
    cfg = HOME / ".codex/config.toml"
    text = cfg.read_text() if cfg.exists() else ""
    block = CODEX_BLOCK % json.dumps(str(DB_PATH.parent))
    if uninstall:
        cfg.write_text(re.sub(r"\n?# gj:begin\n.*?# gj:end\n", "", text, flags=re.S))
    elif "# gj:begin" in text:
        return
    elif "[sandbox_workspace_write]" in text:
        print("gj: add %s to [sandbox_workspace_write] writable_roots in %s"
              % (DB_PATH.parent, cfg))
    else:
        cfg.write_text(text.rstrip("\n") + "\n\n" + block)
        print("gj: let codex sandbox write %s (%s)" % (DB_PATH.parent, cfg))


# ---------------------------------------------------------------- service

LABEL = "co.wetstone.gj"
PLIST = HOME / "Library/LaunchAgents" / (LABEL + ".plist")
LOG_PATH = DB_PATH.parent / "serve.log"


def service_plist(port, script=None, python=None, path=None):
    """launchd agent that runs `gj serve` at login and restarts it if it dies."""
    import plistlib
    env = {"PATH": path or os.environ.get("PATH", "/usr/bin:/bin"), "GJ_DB": str(DB_PATH)}
    return plistlib.dumps({
        "Label": LABEL,
        "ProgramArguments": [python or sys.executable,
                             str(script or Path(__file__).resolve()),
                             "serve", "--port", str(port)],
        "EnvironmentVariables": env,
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "StandardOutPath": str(LOG_PATH),
        "StandardErrorPath": str(LOG_PATH),
    })


def cmd_service(args):
    if sys.platform != "darwin":
        sys.exit("gj: `gj service` uses launchd (macOS only); run `gj serve` under your "
                 "own supervisor elsewhere")
    domain = "gui/%d" % os.getuid()
    url = "http://gj.localhost:%d/" % args.port
    if args.action in ("install", "uninstall") and PLIST.exists():
        run(["launchctl", "bootout", domain + "/" + LABEL])
        if args.action == "uninstall":
            PLIST.unlink()
            print("gj: service removed")
            return
    if args.action == "install":
        PLIST.parent.mkdir(parents=True, exist_ok=True)
        DB_PATH.parent.mkdir(parents=True, exist_ok=True)
        PLIST.write_bytes(service_plist(args.port))
        if run(["launchctl", "bootstrap", domain, str(PLIST)]) is None:
            sys.exit("gj: launchctl bootstrap failed; is port %d already in use?" % args.port)
        print("gj: service installed (%s)\ngj: dashboard at %s  (logs: %s)"
              % (PLIST, url, LOG_PATH))
        if args.open:
            time.sleep(1)
            run(["open", url])
    elif args.action == "status":
        out = run(["launchctl", "print", domain + "/" + LABEL])
        if out is None:
            print("gj: service not running (install with `gj service install`)")
        else:
            state = re.search(r"^\s*state = (.*)$", out, re.M)
            pid = re.search(r"^\s*pid = (\d+)", out, re.M)
            print("gj: service %s%s  %s" % (state.group(1) if state else "loaded",
                                            " (pid %s)" % pid.group(1) if pid else "", url))
    elif args.action == "uninstall":
        print("gj: service not installed")


# ---------------------------------------------------------------- cli

def main(argv=None):
    ap = argparse.ArgumentParser(prog="gj", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("start", help="register the current agent session's work")
    p.add_argument("title")
    p.add_argument("--prompt", help="the initial request (auto-read from agent logs if omitted)")
    p.add_argument("--epic")
    p.add_argument("--pr", action="append", help="PR url to link right away")
    p.add_argument("--agent", choices=AGENTS, help="override detected agent")
    p.add_argument("--session", help="override detected session id")
    p.add_argument("--cwd", help="override working directory")
    p.add_argument("--new", action="store_true", help="always create a new effort")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("pr", help="link PR url(s) to the current effort")
    p.add_argument("urls", nargs="+")
    p.add_argument("--id", type=int)
    p.set_defaults(fn=cmd_pr)

    p = sub.add_parser("status", help="set status: " + ", ".join(STATUSES))
    p.add_argument("status", choices=STATUSES)
    p.add_argument("--note")
    p.add_argument("--id", type=int)
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("note", help="set the effort's note")
    p.add_argument("text", nargs="+")
    p.add_argument("--id", type=int)
    p.set_defaults(fn=cmd_note)

    p = sub.add_parser("edit", help="change title / epic / prompt")
    p.add_argument("--id", type=int)
    p.add_argument("--title")
    p.add_argument("--epic")
    p.add_argument("--prompt")
    p.set_defaults(fn=cmd_edit)

    p = sub.add_parser("rm", help="delete an effort")
    p.add_argument("id", type=int)
    p.set_defaults(fn=cmd_rm)

    p = sub.add_parser("ls", help="list efforts")
    p.add_argument("-a", "--all", action="store_true", help="include done/dropped")
    p.add_argument("-s", "--sync", action="store_true", help="sync GitHub first")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ls)

    p = sub.add_parser("resume", help="print the command that reopens an effort's session")
    p.add_argument("id", type=int)
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("sync", help="refresh PR state from GitHub, discover PRs by branch")
    p.add_argument("--all", action="store_true", help="also re-sync closed PRs")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("serve", help="run the dashboard")
    p.add_argument("--port", type=int, default=int(os.environ.get("GJ_PORT", "7777")))
    p.add_argument("--interval", type=float, default=10, help="minutes between GitHub syncs")
    p.add_argument("--no-sync", action="store_true")
    p.add_argument("--open", action="store_true", help="open in browser")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("service", help="keep the dashboard running in the background (launchd)")
    p.add_argument("action", choices=["install", "uninstall", "status"])
    p.add_argument("--port", type=int, default=int(os.environ.get("GJ_PORT", "7777")))
    p.add_argument("--open", action="store_true", help="open in browser after install")
    p.set_defaults(fn=cmd_service)

    p = sub.add_parser("install", help="add gj instructions to agents' global instruction files")
    p.add_argument("agents", nargs="*", help="subset of: " + ", ".join(AGENTS))
    p.add_argument("--uninstall", action="store_true")
    p.set_defaults(fn=cmd_install)

    args = ap.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
