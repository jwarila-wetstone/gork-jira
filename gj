#!/usr/bin/env python3
"""gj - track lines of effort across Claude, Codex, and Grok agent sessions.

One SQLite file, one CLI, one local dashboard. Stdlib only (Python 3.9+).

Agents call `gj start` when they begin work that will produce a PR, and
`gj pr <url>` once the PR exists. `gj sync` pulls PR state from GitHub (and
finds PRs by branch when an agent forgot to link one). `gj serve` shows the
dashboard, with a copyable command to jump back into each session.
"""
import argparse
import concurrent.futures
import json
import os
import re
import shlex
import sqlite3
import subprocess
import sys
import threading
import time
import urllib.parse
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
DB_PATH = Path(os.environ.get("GJ_DB", HOME / ".local/share/gj/gj.db"))
STALE_DAYS = float(os.environ.get("GJ_STALE_DAYS", "3"))
AGENTS = ("claude", "codex", "grok")
STATUSES = ("active", "review", "blocked", "done", "dropped")
OPEN_STATUSES = ("active", "review", "blocked")
# The path every effort follows. Agents report plan..review with `gj stage`;
# pr, codex, human and merge also follow from GitHub state.
STAGES = ("plan", "build", "verify", "review", "pr", "codex", "human", "merge")
PR_RE = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")

SCHEMA = """
CREATE TABLE IF NOT EXISTS efforts (
    id          INTEGER PRIMARY KEY,
    title       TEXT NOT NULL,
    prompt      TEXT NOT NULL DEFAULT '',
    epic        TEXT NOT NULL DEFAULT '',
    status      TEXT NOT NULL DEFAULT 'active',
    note        TEXT NOT NULL DEFAULT '',
    agent       TEXT NOT NULL DEFAULT '',
    session_id  TEXT NOT NULL DEFAULT '',
    cwd         TEXT NOT NULL DEFAULT '',
    repo        TEXT NOT NULL DEFAULT '',
    branch      TEXT NOT NULL DEFAULT '',
    stage       TEXT NOT NULL DEFAULT '',
    stage_at    REAL NOT NULL DEFAULT 0,    -- when the agent last reported a stage
    created_at  REAL NOT NULL,
    updated_at  REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS prs (
    url            TEXT PRIMARY KEY,
    effort_id      INTEGER NOT NULL REFERENCES efforts(id) ON DELETE CASCADE,
    repo           TEXT NOT NULL,
    number         INTEGER NOT NULL,
    title          TEXT NOT NULL DEFAULT '',
    state          TEXT NOT NULL DEFAULT '',   -- OPEN / MERGED / CLOSED
    draft          INTEGER NOT NULL DEFAULT 0,
    review         TEXT NOT NULL DEFAULT '',   -- APPROVED / CHANGES_REQUESTED / REVIEW_REQUIRED
    checks         TEXT NOT NULL DEFAULT '',   -- pass / fail / pending / ''
    mergeable      TEXT NOT NULL DEFAULT '',   -- MERGEABLE / CONFLICTING / UNKNOWN
    auto_merge     TEXT NOT NULL DEFAULT '',   -- merge method when auto-merge is on, else ''
    pr_updated_at  REAL NOT NULL DEFAULT 0,
    closed_at      REAL NOT NULL DEFAULT 0,    -- when it merged or closed
    synced_at      REAL NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS efforts_session ON efforts(agent, session_id);
CREATE TABLE IF NOT EXISTS summaries (
    kind        TEXT NOT NULL,   -- daily / weekly
    day         TEXT NOT NULL,   -- local date it was made
    text        TEXT NOT NULL,
    span        TEXT NOT NULL DEFAULT '',
    created_at  REAL NOT NULL,
    PRIMARY KEY (kind, day)
);
"""


# ---------------------------------------------------------------- storage

def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH), timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA journal_mode = WAL")
    conn.executescript(SCHEMA)
    cols = {r[1] for r in conn.execute("PRAGMA table_info(prs)")}
    if "auto_merge" not in cols:
        conn.execute("ALTER TABLE prs ADD COLUMN auto_merge TEXT NOT NULL DEFAULT ''")
    if "closed_at" not in cols:
        conn.execute("ALTER TABLE prs ADD COLUMN closed_at REAL NOT NULL DEFAULT 0")
    ecols = {r[1] for r in conn.execute("PRAGMA table_info(efforts)")}
    if "stage" not in ecols:
        conn.execute("ALTER TABLE efforts ADD COLUMN stage TEXT NOT NULL DEFAULT ''")
    if "stage_at" not in ecols:
        conn.execute("ALTER TABLE efforts ADD COLUMN stage_at REAL NOT NULL DEFAULT 0")
    return conn


def now():
    return time.time()


def parse_ts(s):
    if not s:
        return 0.0
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def ago(ts):
    if not ts:
        return "-"
    s = max(0, now() - ts)
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return "%d%s" % (s // n, unit)
    return "now"


# ------------------------------------------------------ session detection

def run(cmd, cwd=None, timeout=30):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def ancestors():
    """(pid, command) for each ancestor process, nearest first."""
    out = run(["ps", "-A", "-o", "pid=,ppid=,comm="]) or ""
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            procs[int(parts[0])] = (int(parts[1]), parts[2])
    chain, pid = [], os.getppid()
    while pid in procs and pid > 1 and len(chain) < 50:
        ppid, comm = procs[pid]
        chain.append((pid, os.path.basename(comm)))
        pid = ppid
    return chain


def detect_agent():
    """Which agent is running us, and its pid. Env vars win over the process tree."""
    if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDECODE"):
        return "claude", int(os.environ.get("CLAUDE_PID") or 0)
    if os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID"):
        return "codex", 0
    for pid, comm in ancestors():
        for a in AGENTS:
            if comm == a or comm.startswith(a + "-") or comm.startswith(a + "."):
                return a, pid
    return "", 0


def claude_session(cwd, pid):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if sid:
        return sid
    proj = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)
    files = sorted(proj.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return files[0].stem if files else ""


def codex_session(cwd, pid):
    sid = os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID") or ""
    if sid:
        return sid
    path = HOME / ".codex/state_5.sqlite"
    if not path.exists():
        cands = sorted((HOME / ".codex").glob("state_*.sqlite"))
        if not cands:
            return ""
        path = cands[-1]
    try:
        c = sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=5)
        row = c.execute(
            "SELECT id FROM threads WHERE cwd = ? AND thread_source = 'user' "
            "ORDER BY updated_at DESC LIMIT 1", (cwd,)).fetchone()
        c.close()
        return row[0] if row else ""
    except sqlite3.Error:
        return ""


def grok_session(cwd, pid):
    sid = os.environ.get("GROK_SESSION_ID", "")
    if sid:
        return sid
    try:
        active = json.loads((HOME / ".grok/active_sessions.json").read_text())
    except (OSError, ValueError):
        return ""
    for s in active:
        if pid and s.get("pid") == pid:
            return s["session_id"]
    same_dir = [s for s in active if s.get("cwd") == cwd]
    same_dir.sort(key=lambda s: s.get("opened_at", ""), reverse=True)
    return same_dir[0]["session_id"] if same_dir else ""


def detect_session(agent, cwd, pid):
    fn = {"claude": claude_session, "codex": codex_session, "grok": grok_session}.get(agent)
    return fn(cwd, pid) if fn else ""


def first_user_prompt(agent, session_id, cwd):
    """Best-effort: pull the session's first user message from the agent's own logs."""
    try:
        if agent == "claude":
            proj = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)
            for line in open(proj / (session_id + ".jsonl")):
                d = json.loads(line)
                if d.get("type") == "user" and not d.get("isMeta"):
                    c = d.get("message", {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(x.get("text", "") for x in c if x.get("type") == "text")
                    if c and not c.startswith("<local-command") and not c.startswith("Caveat:"):
                        m = re.search(r"<command-args>(.*?)</command-args>", c, re.S)
                        return (m.group(1) if m else c).strip()
        elif agent == "codex":
            c = sqlite3.connect("file:%s?mode=ro" % (HOME / ".codex/state_5.sqlite"), uri=True)
            row = c.execute("SELECT first_user_message FROM threads WHERE id = ?",
                            (session_id,)).fetchone()
            c.close()
            return (row[0] or "").strip() if row else ""
        elif agent == "grok":
            d = HOME / ".grok/sessions" / urllib.parse.quote(cwd, safe="") / session_id
            for line in open(d / "chat_history.jsonl"):
                m = json.loads(line)
                if m.get("type") == "user":
                    # Early user messages are injected context; the request is in <user_query>.
                    text = " ".join(x.get("text", "") for x in m.get("content", [])
                                    if isinstance(x, dict))
                    q = re.search(r"<user_query>(.*?)</user_query>", text, re.S)
                    if q:
                        return q.group(1).strip()
    except (OSError, ValueError, sqlite3.Error):
        pass
    return ""


def git_info(cwd):
    branch = run(["git", "branch", "--show-current"], cwd=cwd) or ""
    remote = run(["git", "remote", "get-url", "origin"], cwd=cwd) or ""
    m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?$", remote)
    return (m.group(1) if m else ""), branch


def resume_cmd(e):
    cd = "cd %s && " % shlex.quote(e["cwd"]) if e["cwd"] else ""
    sid = shlex.quote(e["session_id"]) if e["session_id"] else ""
    if e["agent"] == "claude":
        return cd + ("claude --resume %s" % sid if sid else "claude --continue")
    if e["agent"] == "codex":
        return cd + ("codex resume %s" % sid if sid else "codex resume --last")
    if e["agent"] == "grok":
        return cd + ("grok --resume %s" % sid if sid else "grok --continue")
    return cd.rstrip("& ") if cd else ""


# ---------------------------------------------------------------- effort ops

def current_effort(conn, args):
    """Resolve --id, else the effort registered by the calling agent session."""
    if getattr(args, "id", None):
        row = conn.execute("SELECT * FROM efforts WHERE id = ?", (args.id,)).fetchone()
        if not row:
            sys.exit("gj: no effort #%s" % args.id)
        return row
    agent, pid = detect_agent()
    sid = detect_session(agent, os.getcwd(), pid) if agent else ""
    if sid:
        row = conn.execute(
            "SELECT * FROM efforts WHERE agent = ? AND session_id = ? "
            "ORDER BY updated_at DESC LIMIT 1", (agent, sid)).fetchone()
        if row:
            return row
    sys.exit("gj: can't tell which effort this is (no matching session); pass --id N")


def touch(conn, eid, **fields):
    fields["updated_at"] = now()
    sets = ", ".join("%s = ?" % k for k in fields)
    conn.execute("UPDATE efforts SET %s WHERE id = ?" % sets, (*fields.values(), eid))


def add_pr(conn, eid, url):
    m = PR_RE.search(url)
    if not m:
        sys.exit("gj: not a GitHub PR url: %s" % url)
    url = "https://github.com/%s/pull/%s" % (m.group(1), m.group(2))
    conn.execute(
        "INSERT INTO prs(url, effort_id, repo, number) VALUES (?, ?, ?, ?) "
        "ON CONFLICT(url) DO UPDATE SET effort_id = excluded.effort_id",
        (url, eid, m.group(1), int(m.group(2))))
    return url


def cmd_start(args):
    conn = db()
    cwd = os.path.realpath(args.cwd or os.getcwd())
    agent, pid = detect_agent()
    agent = args.agent or agent
    sid = args.session or (detect_session(agent, cwd, pid) if agent else "")
    repo, branch = git_info(cwd)
    prompt = args.prompt or (first_user_prompt(agent, sid, cwd) if sid else "")
    existing = None
    if args.id:
        existing = conn.execute("SELECT * FROM efforts WHERE id = ?", (args.id,)).fetchone()
        if not existing:
            sys.exit("gj: no effort #%s" % args.id)
    elif not args.title:
        sys.exit("gj: give a title, or --id N to continue an existing effort")
    elif agent and sid:
        existing = conn.execute(
            "SELECT id FROM efforts WHERE agent = ? AND session_id = ? AND status IN (%s) "
            "ORDER BY id DESC LIMIT 1" % ",".join("?" * len(OPEN_STATUSES)),
            (agent, sid, *OPEN_STATUSES)).fetchone()
    if existing and not args.new:
        eid = existing["id"]
        fields = dict(cwd=cwd, repo=repo, branch=branch)
        if args.title:
            fields["title"] = args.title
        if args.id:   # this session now carries the effort: resume points here
            fields.update(agent=agent, session_id=sid)
            if existing["status"] in ("done", "dropped"):
                fields["status"] = "active"
        if args.prompt:
            fields["prompt"] = args.prompt
        if args.epic:
            fields["epic"] = args.epic
        touch(conn, eid, **fields)
        verb = "attached to" if args.id else "updated"
    else:
        t = now()
        eid = conn.execute(
            "INSERT INTO efforts(title, prompt, epic, agent, session_id, cwd, repo, branch, stage, "
            "stage_at, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
            (args.title, prompt, args.epic or "", agent, sid, cwd, repo, branch, "plan",
             t, t, t)).lastrowid
        verb = "started"
    for url in args.pr or []:
        add_pr(conn, eid, url)
    conn.commit()
    title = args.title or existing["title"]
    print("gj: %s effort #%d [%s %s] %s" % (verb, eid, agent or "?", sid[:8] or "-", title))


def cmd_pr(args):
    conn = db()
    e = current_effort(conn, args)
    urls = [add_pr(conn, e["id"], u) for u in args.urls]
    repo, branch = git_info(e["cwd"]) if e["cwd"] and os.path.isdir(e["cwd"]) else ("", "")
    # A new PR reopens a closed effort: a long effort's next piece.
    fields = {"status": "review"} if e["status"] in ("active", "done", "dropped") else {}
    if branch:
        fields.update(branch=branch, repo=repo or e["repo"])
    touch(conn, e["id"], **fields)
    conn.commit()
    sync_prs(conn, urls)
    print("gj: #%d linked %s" % (e["id"], " ".join(urls)))


def cmd_status(args):
    conn = db()
    e = current_effort(conn, args)
    fields = {"status": args.status}
    if args.note is not None:
        fields["note"] = args.note
    touch(conn, e["id"], **fields)
    conn.commit()
    print("gj: #%d -> %s" % (e["id"], args.status))


def cmd_stage(args):
    conn = db()
    e = current_effort(conn, args)
    fields = {"stage": args.stage, "stage_at": now()}
    if args.note is not None:
        fields["note"] = args.note
    if e["status"] in ("blocked", "done", "dropped"):
        fields["status"] = "active"
    touch(conn, e["id"], **fields)
    conn.commit()
    print("gj: #%d stage -> %s" % (e["id"], args.stage))


def stage_of(e):
    """The furthest stage the effort has reached: the agent's report, or GitHub's if further."""
    s = e.get("stage") or ""
    rank = STAGES.index(s) if s in STAGES else -1
    last_pr = max([p["pr_updated_at"] for p in e["prs"]] or [0])
    if s and (e.get("stage_at") or 0) > last_pr:
        return s   # the agent reported after the last PR moved: it's on the next piece

    def reach(x):
        nonlocal s, rank
        if STAGES.index(x) > rank:
            s, rank = x, STAGES.index(x)
    open_prs = [p for p in e["prs"] if p["state"] in ("OPEN", "")]
    if any(p["state"] != "CLOSED" for p in e["prs"]):   # a PR closed unmerged doesn't count
        reach("codex")
    if open_prs and all(p["review"] == "APPROVED" for p in open_prs):
        reach("merge")
    if e["prs"] and not open_prs and any(p["state"] == "MERGED" for p in e["prs"]):
        reach("merge")
    return s


def cmd_note(args):
    conn = db()
    e = current_effort(conn, args)
    touch(conn, e["id"], note=" ".join(args.text))
    conn.commit()
    print("gj: #%d noted" % e["id"])


def cmd_edit(args):
    conn = db()
    e = current_effort(conn, args)
    fields = {k: v for k, v in (("title", args.title), ("epic", args.epic),
                                ("prompt", args.prompt)) if v is not None}
    touch(conn, e["id"], **fields)
    conn.commit()
    print("gj: #%d edited" % e["id"])


def cmd_rm(args):
    conn = db()
    conn.execute("DELETE FROM efforts WHERE id = ?", (args.id,))
    conn.commit()
    print("gj: #%d deleted" % args.id)


# ---------------------------------------------------------------- github sync

GH_FIELDS = ("closedAt,number,title,state,isDraft,reviewDecision,mergeable,statusCheckRollup,updatedAt,"
             "autoMergeRequest")


def rollup(checks):
    states = set()
    for c in checks or []:
        s = (c.get("conclusion") or c.get("state") or c.get("status") or "").upper()
        if s in ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"):
            states.add("fail")
        elif s in ("SUCCESS", "NEUTRAL", "SKIPPED", "COMPLETED"):
            states.add("pass")
        else:
            states.add("pending")
    for s in ("fail", "pending", "pass"):
        if s in states:
            return s
    return ""


def fetch_pr(url):
    out = run(["gh", "pr", "view", url, "--json", GH_FIELDS])
    return url, (json.loads(out) if out else None)


def sync_prs(conn, urls):
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        results = list(pool.map(fetch_pr, urls))
    ok = 0
    for url, d in results:
        if not d:
            continue
        ok += 1
        conn.execute(
            "UPDATE prs SET title=?, state=?, draft=?, review=?, checks=?, mergeable=?, "
            "auto_merge=?, pr_updated_at=?, closed_at=?, synced_at=? WHERE url=?",
            (d["title"], d["state"], int(d["isDraft"]), d.get("reviewDecision") or "",
             rollup(d.get("statusCheckRollup")), d.get("mergeable") or "",
             (d.get("autoMergeRequest") or {}).get("mergeMethod") or "",
             parse_ts(d.get("updatedAt")), parse_ts(d.get("closedAt")), now(), url))
    conn.commit()
    return ok, len(urls)


def discover_prs(conn):
    """Link PRs the agent forgot to record, by looking up each open effort's branch."""
    found = []
    rows = conn.execute(
        "SELECT * FROM efforts WHERE status IN (%s) AND NOT EXISTS "
        "(SELECT 1 FROM prs WHERE prs.effort_id = efforts.id)"
        % ",".join("?" * len(OPEN_STATUSES)), OPEN_STATUSES).fetchall()
    for e in rows:
        branch, repo = e["branch"], e["repo"]
        if e["cwd"] and os.path.isdir(e["cwd"]):
            repo, branch = git_info(e["cwd"])
            repo = repo or e["repo"]
        if not repo or not branch or branch in ("main", "master", "develop", "trunk"):
            continue
        out = run(["gh", "pr", "list", "--repo", repo, "--head", branch, "--state", "all",
                   "--json", "url,createdAt"])
        for pr in json.loads(out or "[]"):
            if parse_ts(pr["createdAt"]) >= e["created_at"] - 3600:
                found.append(add_pr(conn, e["id"], pr["url"]))
        if branch != e["branch"]:
            conn.execute("UPDATE efforts SET branch = ? WHERE id = ?", (branch, e["id"]))
    conn.commit()
    return found


def auto_close(conn):
    """Efforts whose PRs are all merged/closed are done.

    A blocked effort closes too when its last PR closed after it was blocked: the block was
    about getting the PR out. A block set after the merge (follow-up work) stays open."""
    rows = conn.execute(
        "SELECT e.id, e.status, e.updated_at, e.stage_at, e.agent, e.session_id, e.cwd, SUM(p.state = 'MERGED') merged, "
        "SUM(p.state IN ('MERGED','CLOSED')) shut, COUNT(*) n, MAX(p.pr_updated_at) last_pr "
        "FROM efforts e JOIN prs p ON p.effort_id = e.id "
        "WHERE e.status IN ('active','review','blocked') GROUP BY e.id").fetchall()
    closed = []
    for r in rows:
        if r["status"] == "blocked" and (not r["merged"] or (r["last_pr"] or 0) <= r["updated_at"]):
            continue   # never auto-drop a blocked effort; its PR may come back in another form
        if (r["stage_at"] or 0) > (r["last_pr"] or 0):
            continue   # the agent reported work after the last PR: a long effort, still going
        if liveness(dict(r))["state"] == "working":
            continue   # its agent is mid-turn, likely on the next piece
        if r["n"] and r["shut"] == r["n"]:
            status = "done" if r["merged"] else "dropped"
            touch(conn, r["id"], status=status)
            closed.append((r["id"], status))
    conn.commit()
    return closed


def sync_all(conn, all_prs=False):
    found = discover_prs(conn)
    q = "SELECT url FROM prs" if all_prs else (
        "SELECT p.url FROM prs p JOIN efforts e ON e.id = p.effort_id "
        "WHERE e.status IN ('active','review','blocked') OR p.state IN ('', 'OPEN')")
    urls = [r["url"] for r in conn.execute(q)]
    ok, total = sync_prs(conn, urls)
    closed = auto_close(conn)
    return {"discovered": found, "synced": ok, "total": total, "closed": closed}


def cmd_sync(args):
    conn = db()
    r = sync_all(conn, args.all)
    print("gj: synced %d/%d PRs" % (r["synced"], r["total"]))
    for u in r["discovered"]:
        print("gj: discovered %s" % u)
    for eid, st in r["closed"]:
        print("gj: #%d -> %s (all PRs closed)" % (eid, st))


# ---------------------------------------------------------------- views

def load(conn, include_closed=False):
    q = "SELECT * FROM efforts"
    if not include_closed:
        q += " WHERE status IN ('active','review','blocked')"
    efforts = [dict(r) for r in conn.execute(q)]
    prs = {}
    for p in conn.execute("SELECT * FROM prs ORDER BY number"):
        prs.setdefault(p["effort_id"], []).append(dict(p))
    for e in efforts:
        e["prs"] = prs.get(e["id"], [])
        e["resume"] = resume_cmd(e)
        e["flags"] = flags(e)
        e["stage_set"], e["stage"] = e["stage"], stage_of(e)
        last = max([e["updated_at"]] + [p["pr_updated_at"] for p in e["prs"]])
        e["last_activity"] = last
    efforts.sort(key=lambda e: (e["status"] in ("done", "dropped"), -len(e["flags"]),
                                e["last_activity"]))
    return efforts


def flags(e):
    """Why this effort needs your attention. Empty list = nothing to do right now."""
    out = []
    if e["status"] in ("done", "dropped"):
        return out
    open_prs = [p for p in e["prs"] if p["state"] in ("OPEN", "")]
    for p in open_prs:
        tag = "#%d " % p["number"]
        if p["checks"] == "fail":
            out.append(tag + "checks failing")
        if p["mergeable"] == "CONFLICTING":
            out.append(tag + "merge conflict")
        if p["review"] == "CHANGES_REQUESTED":
            out.append(tag + "changes requested")
        if (p["review"] == "APPROVED" and p["checks"] != "fail" and not p["draft"]
                and not p.get("auto_merge")):
            out.append(tag + "approved - merge it")
        if p["pr_updated_at"] and now() - p["pr_updated_at"] > STALE_DAYS * 86400:
