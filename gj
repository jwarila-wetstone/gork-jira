<script>
const LANES = [
  ['working', 'Working', 'No agent running'],
  ['you', 'Needs you', 'Nothing waiting on you'],
  ['review', 'In review', 'No open PRs'],
];
const STATUSES = ['active', 'review', 'blocked', 'done', 'dropped'];
let data = null, lastOk = 0, openId = null;
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function ago(ts) {
  if (!ts) return '';
  const s = Math.max(0, Date.now() / 1000 - ts);
  if (s < 60) return 'now';
  for (const [u, n] of [['d', 86400], ['h', 3600], ['m', 60]]) if (s >= n) return Math.floor(s / n) + u;
}
function toast(t) { const e = $('toast'); e.textContent = t; e.classList.add('on'); setTimeout(() => e.classList.remove('on'), 1500); }
function where(e, full) {
  let repo = e.repo || (e.cwd || '').split('/').pop();
  if (!full) repo = repo.split('/').pop();
  return [repo, e.branch].filter(Boolean).join(' · ');
}
function prChip(p) {
  const bits = ['#' + p.number];
  let cls = '';
  if (p.state === 'MERGED') { bits.push('merged'); cls = 'merged'; }
  else if (p.state === 'CLOSED') { bits.push('closed'); cls = 'bad'; }
  else {
    if (p.draft) bits.push('draft');
    if (p.checks === 'fail') { bits.push('✕'); cls = 'bad'; }
    else if (p.checks === 'pending') bits.push('…');
    else if (p.checks === 'pass') bits.push('✓');
    if (p.mergeable === 'CONFLICTING') { bits.push('conflict'); cls = 'bad'; }
    if (p.review === 'CHANGES_REQUESTED') { bits.push('changes'); cls = 'bad'; }
    else if (p.review === 'APPROVED') { bits.push('approved'); cls = cls || 'ok'; }
    if (p.auto_merge) { bits.push('auto-merge'); cls = cls || 'ok'; }
  }
  return `<a class="chip ${cls}" href="${esc(p.url)}" target="_blank" rel="noopener" title="${esc(p.title)}">${esc(bits.join(' '))}</a>`;
}
const openPrs = e => e.prs.filter(p => p.state === 'OPEN' || p.state === '');

function card(e) {
  const live = e.live || {};
  let sub = '';
  if (e.lane === 'working') sub = `<div class="sub"><i class="pulse"></i><span>${esc(live.doing || 'Working…')}</span></div>`;
  else if (e.why) sub = `<div class="sub"><span>${esc(e.why)}</span></div>`;
  return `<article class="card ${e.lane} ${openId === e.id ? 'sel' : ''}" data-id="${e.id}">
    <div class="r1"><i class="ag ${esc(e.agent)}" title="${esc(e.agent)}"></i><span class="title">${esc(e.title)}</span><span class="age">${ago(e.last_activity)}</span></div>
    ${sub}
    <div class="meta"><span class="where" title="${esc(where(e, true))}">${esc(where(e))}</span>${openPrs(e).map(prChip).join('')}</div>
  </article>`;
}
function row(e) {
  const why = e.lane === 'shipped' ? (e.prs.length ? '#' + e.prs[e.prs.length - 1].number + (e.prs.length > 1 ? ' +' + (e.prs.length - 1) : '') : '') : (e.why || '');
  return `<div class="row ${openId === e.id ? 'sel' : ''}" data-id="${e.id}" title="${esc(e.title)}">
    <span class="t ${e.status}">${esc(e.title)}</span><span class="why">${esc(why)}</span><span class="age">${ago(e.lane === 'shipped' ? e.updated_at : e.last_activity)}</span></div>`;
}

function matches(e, q) {
  if (!q) return true;
  return [e.title, e.repo, e.branch, e.epic, e.agent, e.note, e.why, e.live.doing, e.prompt, ...e.prs.map(p => p.title + ' #' + p.number)]
    .join(' ').toLowerCase().includes(q);
}

function render() {
  if (!data) return;
  const q = $('q').value.trim().toLowerCase();
  const by = {working: [], you: [], review: [], idle: [], shipped: []};
  for (const e of data.efforts) if (matches(e, q)) by[e.lane].push(e);
  by.working.sort((a, b) => b.live.seen - a.live.seen);
  for (const k of ['you', 'review', 'idle']) by[k].sort((a, b) => b.last_activity - a.last_activity);
  by.shipped.sort((a, b) => b.updated_at - a.updated_at);
  const done = by.shipped.filter(e => e.status === 'done').length;

  $('counts').innerHTML = [['working', by.working.length, 'working'], ['you', by.you.length, 'need you'],
    ['review', by.review.length, 'in review'], ['idle', by.idle.length, 'quiet'], ['shipped', done, 'shipped']]
    .map(([k, n, l]) => `<span class="count ${k} ${n ? '' : 'zero'}"><b>${n}</b>${l}</span>`).join('');

  // empty columns shrink so busy ones get the room
  const cols = LANES.map(([k]) => by[k].length ? 'minmax(0,1fr)' : 'minmax(0,.45fr)');
  $('board').style.gridTemplateColumns = cols.join(' ') + ' minmax(0,.85fr)';
  const scrolls = [...document.querySelectorAll('.scroll')].map(s => s.scrollTop);

  $('board').innerHTML = LANES.map(([k, title, empty]) => `<section class="lane ${k}"><h2><i></i>${title}<span class="n">${by[k].length}</span></h2>
      <div class="scroll">${by[k].length ? by[k].map(card).join('') : `<div class="hint">${q ? 'No matches' : empty}</div>`}</div></section>`).join('') +
    `<section class="lane rest"><h2><i></i>Quiet<span class="n">${by.idle.length}</span></h2><div class="scroll">
      ${by.idle.map(row).join('') || `<div class="hint">${q ? 'No matches' : 'Nothing stalled'}</div>`}
      ${by.shipped.length ? `<div class="sect"><i></i>Closed this week · ${by.shipped.length}</div>` + by.shipped.map(row).join('') : ''}
    </div></section>`;
  document.querySelectorAll('.scroll').forEach((s, i) => { s.scrollTop = scrolls[i] || 0; });

  document.title = (by.you.length ? `(${by.you.length}) ` : '') + 'gj' + (by.working.length ? ` · ${by.working.length} working` : '');
  $('synced').textContent = data.synced ? ago(data.synced) : 'never';
  $('synced').title = 'GitHub last synced';
  if (openId !== null) drawer();
}

function drawer() {
  const e = data && data.efforts.find(x => x.id === openId);
  if (!e) return closeDrawer();
  const prs = e.prs.map(p => `<div class="prrow"><a href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.repo)}#${p.number}</a> ${prChip(p)} ${esc(p.title)}</div>`).join('');
  const live = e.live || {};
  const keep = $('drawer').querySelector('.dbody');
  const top = keep ? keep.scrollTop : 0;
  $('drawer').innerHTML = `<div class="dhead"><i class="ag ${esc(e.agent)}" style="margin-top:6px"></i><span class="title">${esc(e.title)}</span><button class="x" data-act="close" title="Close (Esc)">×</button></div>
    <div class="dbody">
      ${e.why ? `<h4>Why it's here</h4><div class="txt why">${esc(e.why)}</div>` : ''}
      ${live.doing ? `<h4>${e.lane === 'working' ? 'Doing now' : "Agent's last word"} · ${ago(live.seen)}</h4><div class="txt">${esc(live.doing)}</div>` : ''}
