SUMMARY_MODEL = "claude-opus-5-5"
SUMMARY_PROMPTS = {
    "daily": """You write a developer's morning summary of the software work their AI coding agents did.
The input lists every tracked effort: what happened in the window, and what is still open now.
Write Markdown with exactly these three sections and nothing before or after:

## Executive summary
