const STATUSES = ['active', 'review', 'blocked', 'done', 'dropped'];
const STAGES = ['plan', 'build', 'verify', 'review', 'pr', 'codex', 'human', 'merge'];
const STAGE_NAMES = {plan: 'Plan', build: 'Build', verify: 'Verify', review: 'Self-review', pr: 'PR',
  codex: 'Codex review', human: 'Human approval', merge: 'Merge'};
// Something on GitHub stops this stage from moving (failing checks, conflict, changes requested).
const BLOCKERS = /checks failing|merge conflict|changes requested/;
function strip(e) {
  const i = STAGES.indexOf(e.stage);
  if (i < 0) return '';
  const bad = e.flags.some(f => BLOCKERS.test(f));
  return `<div class="steps"><div class="bar">` +
    STAGES.map((s, j) => `<i class="${j < i ? 'd' : j === i ? 'c' + (bad ? ' bad' : '') : ''}" title="${j + 1}. ${STAGE_NAMES[s]}${j < i ? ' ✓' : j === i ? ' (now)' : ''}"></i>`).join('') +
    `</div><span class="lbl ${bad ? 'bad' : ''}">${i + 1}/${STAGES.length} <b>${STAGE_NAMES[e.stage]}</b>${bad ? ' · blocked' : ''}</span></div>`;
