  const i = STAGES.indexOf(e.stage);
  return `<div class="path">${STAGES.map((s, j) => `<span class="${j < i ? 'd' : j === i ? 'c' : ''}">${j < i ? '✓ ' : ''}${STAGE_NAMES[s]}</span>`).join('')}</div>`;
