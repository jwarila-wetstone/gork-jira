  return `<article class="card ${e.lane} ${openId === e.id ? 'sel' : ''}" data-id="${e.id}">
    <div class="r1"><i class="ag ${esc(e.agent)}" title="${esc(e.agent)}"></i><span class="title">${esc(e.title)}</span><span class="age">${ago(e.last_activity)}</span></div>
