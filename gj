MARK_BEGIN = "<!-- gj:begin -->"
MARK_END = "<!-- gj:end -->"
INSTRUCTIONS = MARK_BEGIN + """
## Effort tracking and workflow (gj)

The user tracks building work with the `gj` CLI, so no PR is forgotten, and moves it through the
same stages.

**What enters the flow:** only work that builds something, meaning a code change that will go into a PR.
Questions, investigations, debugging, reviews and explanations are normal work: don't register them or
use the stages. If one of them ends with a change the user wants built, enter the flow then, starting at
`plan` with what you found.

For building work, do this without being asked:

1. Before you start, register it: `gj start "<short title>" --prompt "<the user's request, verbatim>"`
   (add `--epic "<name>"` if the user names a larger effort). Run it from the repo or worktree you work in.
   Run it once per session; running it again only updates the title. New work starts at the `plan` stage.
   If the user says this session continues effort #N, attach to it instead: `gj start --id N`.
2. Report each stage as you enter it with `gj stage <stage>`:

   | Stage | What you do | Move on when |
   |---|---|---|
   | `plan` | Ask the questions whose answers change the design. Then propose a plan: the change, its risks, and **how you will verify it** (which tests, E2E run, or environment rehearsal). Keep it to a few lines for a small change. Stop and wait. | The user approves it. If the request already settles the approach, say so and go on. |
   | `build` | Implement the plan. | It is built. |
   | `verify` | Run the verification the plan named, in the most realistic environment it calls for. | It passes: `gj stage review --note "<what you ran, where, and the result>"`. If it fails, go back to `build`. |
   | `review` | Review your own diff once (`/code-review` in Claude Code) and fix what is real. One pass. | Open the PR, then run `gj pr <url>`. |
   | `codex` | The Codex review loop below. | `gj stage human` |
   | `human`, `merge` | Nothing. gj follows approval and merge on GitHub. | |

   A long effort goes around more than once. When one PR is out and the next piece starts, report
   `gj stage plan` (or `build`) again. The effort stays open while you report work after its last PR.
3. **Codex review loop.** Drive it yourself; don't wait for the user to tell you a review is in.
   Codex reviews the PR on GitHub when it opens. Each round:
   - Wait for the review with `gj codex-wait`. It watches GitHub without using tokens and prints the
     review when it lands: the round, and each finding with its file and line. In Claude Code, run it
     as a background command (`run_in_background`); you are woken when it finishes, so end your turn
     meanwhile. Elsewhere, run it in the foreground with a 45-minute command timeout.
     Never write your own sleep or polling loop.
   - If it reports no major issues, the loop is done.
   - Otherwise fix the real findings and re-run the verification the fix touches. Reply on the thread to
     any finding you disagree with, saying why. Push, then run `gj codex-wait --request`: it comments
     `@codex review` and waits for the next round.
   - Stop after 3 rounds with findings, or sooner when nothing Codex raises is a real problem. Then run
     `gj stage human` and summarize what is still open for the human reviewer. If `gj codex-wait`
     times out, tell the user and stop.
4. If you get stuck waiting on the user: `gj status blocked --note "<what you need>"`.
   When the work is finished without a PR: `gj status done`.

`gj` detects the agent and session on its own. If a `gj` command fails, mention it once and keep working.
""" + MARK_END + "\n"

TARGETS = {
    "claude": HOME / ".claude/CLAUDE.md",
    "codex": HOME / ".codex/AGENTS.md",
    "grok": HOME / ".grok/AGENTS.md",
}


def cmd_install(args):
    for agent in args.agents or AGENTS:
        if agent not in TARGETS:
            sys.exit("gj: unknown agent %s" % agent)
        path = TARGETS[agent]
        if not path.parent.exists():
            print("gj: skip %s (%s missing)" % (agent, path.parent))
            continue
        text = path.read_text() if path.exists() else ""
        if MARK_BEGIN in text:
            text = re.sub(re.escape(MARK_BEGIN) + ".*?" + re.escape(MARK_END) + "\n?",
                          lambda m: INSTRUCTIONS, text, flags=re.S)
        elif args.uninstall:
            continue
        else:
            text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + INSTRUCTIONS
        if args.uninstall:
            text = text.replace(INSTRUCTIONS, "").rstrip("\n") + "\n"
        path.write_text(text)
        print("gj: %s %s" % ("removed from" if args.uninstall else "installed in", path))
        if agent == "codex":
            codex_sandbox(args.uninstall)


CODEX_BLOCK = '# gj:begin\n[sandbox_workspace_write]\nwritable_roots = [%s]\n# gj:end\n'


def codex_sandbox(uninstall):
    """Codex's default sandbox only writes inside the workspace; let it write the gj db."""
    cfg = HOME / ".codex/config.toml"
    text = cfg.read_text() if cfg.exists() else ""
    block = CODEX_BLOCK % json.dumps(str(DB_PATH.parent))
    if uninstall:
        cfg.write_text(re.sub(r"\n?# gj:begin\n.*?# gj:end\n", "", text, flags=re.S))
    elif "# gj:begin" in text:
        return
    elif "[sandbox_workspace_write]" in text:
        print("gj: add %s to [sandbox_workspace_write] writable_roots in %s"
              % (DB_PATH.parent, cfg))
    else:
        cfg.write_text(text.rstrip("\n") + "\n\n" + block)
        print("gj: let codex sandbox write %s (%s)" % (DB_PATH.parent, cfg))


# ---------------------------------------------------------------- service

LABEL = "co.wetstone.gj"
PLIST = HOME / "Library/LaunchAgents" / (LABEL + ".plist")
LOG_PATH = DB_PATH.parent / "serve.log"


def service_plist(port, script=None, python=None, path=None):
    """launchd agent that runs `gj serve` at login and restarts it if it dies."""
    import plistlib
    env = {"PATH": path or os.environ.get("PATH", "/usr/bin:/bin"), "GJ_DB": str(DB_PATH)}
    return plistlib.dumps({
        "Label": LABEL,
        "ProgramArguments": [python or sys.executable,
                             str(script or Path(__file__).resolve()),
                             "serve", "--port", str(port)],
        "EnvironmentVariables": env,
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "StandardOutPath": str(LOG_PATH),
        "StandardErrorPath": str(LOG_PATH),
    })


def cmd_service(args):
    if sys.platform != "darwin":
        sys.exit("gj: `gj service` uses launchd (macOS only); run `gj serve` under your "
                 "own supervisor elsewhere")
    domain = "gui/%d" % os.getuid()
    url = "http://gj.localhost:%d/" % args.port
    if args.action in ("install", "uninstall") and PLIST.exists():
        run(["launchctl", "bootout", domain + "/" + LABEL])
        if args.action == "uninstall":
            PLIST.unlink()
            print("gj: service removed")
            return
    if args.action == "install":
        PLIST.parent.mkdir(parents=True, exist_ok=True)
        DB_PATH.parent.mkdir(parents=True, exist_ok=True)
        PLIST.write_bytes(service_plist(args.port))
        if run(["launchctl", "bootstrap", domain, str(PLIST)]) is None:
            sys.exit("gj: launchctl bootstrap failed; is port %d already in use?" % args.port)
        print("gj: service installed (%s)\ngj: dashboard at %s  (logs: %s)"
              % (PLIST, url, LOG_PATH))
        if args.open:
            time.sleep(1)
            run(["open", url])
    elif args.action == "status":
        out = run(["launchctl", "print", domain + "/" + LABEL])
        if out is None:
            print("gj: service not running (install with `gj service install`)")
        else:
            state = re.search(r"^\s*state = (.*)$", out, re.M)
            pid = re.search(r"^\s*pid = (\d+)", out, re.M)
            print("gj: service %s%s  %s" % (state.group(1) if state else "loaded",
                                            " (pid %s)" % pid.group(1) if pid else "", url))
    elif args.action == "uninstall":
        print("gj: service not installed")


