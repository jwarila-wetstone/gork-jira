# ---------------------------------------------------------------- live activity
#
# What is each agent doing right now? Read the tail of its own session log:
# how recently it was written, whether the last turn finished, and its latest action.

WORKING_SECS = 120          # log written this recently + turn not finished = working
_log_paths = {}


def tail_lines(path, nbytes=262144):
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - nbytes))
        data = f.read().decode("utf-8", "replace")
    lines = data.splitlines()
    return lines[1:] if size > nbytes else lines   # first line may be cut


def clip(s, n=160):
    s = " ".join(str(s or "").split())
    return s if len(s) <= n else s[:n - 1] + "…"


def session_log(e):
    key = (e["agent"], e["session_id"])
    p = _log_paths.get(key)
    if p and p.exists():
        return p
    p, sid, cwd = None, e["session_id"], e["cwd"]
    if not sid:
        return None
    if e["agent"] == "claude":
        p = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd) / (sid + ".jsonl")
        if not p.exists():
            p = next((HOME / ".claude/projects").glob("*/%s.jsonl" % sid), None)
    elif e["agent"] == "codex":
        p = next((HOME / ".codex/sessions").glob("*/*/*/rollout-*%s.jsonl" % sid), None)
    elif e["agent"] == "grok":
        p = HOME / ".grok/sessions" / urllib.parse.quote(cwd, safe="") / sid / "chat_history.jsonl"
        if not p.exists():
            p = next((HOME / ".grok/sessions").glob("*/%s/chat_history.jsonl" % sid), None)
    if p and p.exists():
        _log_paths[key] = p
        return p
    return None


def claude_turn(entries):
    """(turn_done, latest action) from Claude transcript entries, newest last."""
    done, doing = None, ""
    for d in reversed(entries):
        t = d.get("type")
        if t not in ("user", "assistant") or d.get("isMeta"):
            continue
        content = d.get("message", {}).get("content")
        blocks = content if isinstance(content, list) else [{"type": "text", "text": content}]
        kinds = {b.get("type") for b in blocks if isinstance(b, dict)}
        if done is None:
            done = t == "assistant" and "text" in kinds and "tool_use" not in kinds
        for b in reversed(blocks):
            if not isinstance(b, dict):
                continue
            if t == "assistant" and b.get("type") == "tool_use":
                inp = b.get("input") or {}
                detail = (inp.get("description") or inp.get("file_path") or inp.get("pattern")
                          or inp.get("command") or inp.get("prompt") or "")
                name = b.get("name", "").split("__")[-1]
                doing = "%s: %s" % (name, detail) if detail else name
            elif t == "assistant" and b.get("type") == "text" and b.get("text", "").strip():
                doing = b["text"]
            if doing:
                return done, clip(doing)
    return bool(done), doing


def codex_turn(entries):
    done, doing = None, ""
    for d in reversed(entries):
        p = d.get("payload") or {}
        if done is None and d.get("type") == "event_msg" and p.get("type") in (
                "task_complete", "task_started", "turn_aborted"):
            done = p["type"] != "task_started"
        if not doing and d.get("type") == "response_item":
            if p.get("type") == "message" and p.get("role") == "assistant":
                doing = " ".join(c.get("text", "") for c in p.get("content") or [])
            elif p.get("type") in ("function_call", "custom_tool_call", "local_shell_call"):
                doing = "%s: %s" % (p.get("name") or "shell", p.get("arguments") or p.get("input") or "")
        if done is not None and doing:
            break
    return bool(done), clip(doing)


def grok_turn(entries):
    done, doing = None, ""
    for d in reversed(entries):
        t = d.get("type")
        if done is None and t in ("assistant", "tool_result", "user"):
            done = t == "assistant" and not d.get("tool_calls")
        if not doing and t == "assistant":
            calls = d.get("tool_calls") or []
            if d.get("content"):
                doing = d["content"]
            elif calls:
                doing = calls[-1].get("name", "")
        if done is not None and doing:
            break
    return bool(done), clip(doing)


def liveness(e):
    """{'seen': ts, 'state': working|stalled|done|'' , 'doing': str} for an effort's session."""
    p = session_log(e)
    if not p:
        return {"seen": 0, "state": "", "doing": ""}
    try:
        seen = p.stat().st_mtime
        entries = []
        for line in tail_lines(p):
            try:
                entries.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        return {"seen": 0, "state": "", "doing": ""}
    fn = {"claude": claude_turn, "codex": codex_turn, "grok": grok_turn}[e["agent"]]
    done, doing = fn(entries)
    if done:
        state = "done"
    else:
        state = "working" if now() - seen < WORKING_SECS else "stalled"
    if state != "working" and e["agent"] == "claude":
        sub = subagent_live(p)   # the main log goes quiet while it waits on a subagent
        if sub:
            seen, state, doing = max(seen, sub[0]), "working", "Subagent · " + sub[1]
    return {"seen": seen, "state": state, "doing": doing}


def subagent_live(log):
    """(mtime, doing) for a Claude subagent of this session that is still running, else None.
    Subagents log to <session>/subagents/agent-*.jsonl, with a .meta.json that says when they
    finish; without one, a recent log that hasn't handed back counts."""
    try:
        logs = [(f.stat().st_mtime, f) for f in log.with_suffix("").joinpath("subagents").glob("agent-*.jsonl")]
    except OSError:
        return None
    for mtime, f in sorted(logs, reverse=True):
        if now() - mtime >= 3600:   # a running subagent that has been silent this long is gone
            break
        try:
            meta = json.loads(f.with_name(f.name[:-len(".jsonl")] + ".meta.json").read_text())
        except (OSError, ValueError):
            meta = None
        if meta and meta.get("finished"):
            continue
        if not meta and now() - mtime >= WORKING_SECS:
            continue
        entries = []
        for line in tail_lines(f):
            try:
                entries.append(json.loads(line))
            except ValueError:
                pass
        done, doing = claude_turn(entries)
        if meta or not (done or doing.startswith("SubagentHandback")):
            return mtime, doing
    return None


def lane(e):
    """Which board column an open effort belongs in, and why."""
    live = e.get("live") or {}
    open_prs = [p for p in e["prs"] if p["state"] in ("OPEN", "")]
    if live.get("state") == "working":
        return "working", ""
    urgent = [f for f in e["flags"]
              if " stale " not in " %s " % f and "idle" not in f and f != "blocked"]
    if urgent:   # failing checks, conflict, changes requested: auto-merge can't finish these
        return "you", urgent[0]
    if open_prs and all(p.get("auto_merge") for p in open_prs):
        # You turned on auto-merge and nothing blocks it, so it's handed off
        # (even if an agent left the effort 'blocked').
        return "review", "auto-merge on"
    if e["status"] == "blocked":
        return "you", e["note"] or "blocked"
    if live.get("state") == "stalled" and now() - live["seen"] < 86400:
        return "you", "agent stopped mid-task (approval prompt or crash?)"
    if e.get("stage") == "human" and open_prs:
        return "you", "Codex review done, ready for your approval"
    last = max(e["updated_at"], live.get("seen") or 0,
               *[p["pr_updated_at"] for p in open_prs])
    quiet = now() - last > STALE_DAYS * 86400
    why = e["flags"][0] if e["flags"] else ""
    if open_prs and not quiet:
        return "review", why
    if not open_prs and live.get("state") == "done" and now() - live["seen"] < 86400:
        if e.get("stage") == "plan":
            return "you", "plan ready for your review"
        return "you", "agent finished its turn and is waiting on you"
    return "idle", why


def board(conn):
    efforts = load(conn, include_closed=True)
    week = now() - 7 * 86400
    out = []
    owner = {}   # a session's newest effort is the one its live work belongs to
    for e in efforts:
        k = (e["agent"], e["session_id"])
        if e["session_id"] and e["id"] > owner.get(k, 0):
            owner[k] = e["id"]
    for e in efforts:
        closed = e["status"] in ("done", "dropped")
        if closed and e["updated_at"] < week:
            continue
        e["live"] = liveness(e)
        live = e["live"]
        mine = owner.get((e["agent"], e["session_id"]), e["id"]) == e["id"]
        if closed and not (mine and (live["state"] == "working" or (
                live["state"] == "stalled" and now() - live["seen"] < 86400))):
            e["lane"], e["why"] = "shipped", ""
        else:   # an agent still mid-turn on a closed effort keeps it on the board
            e["lane"], e["why"] = lane(e)
        e["last_activity"] = max(e["last_activity"], e["live"]["seen"])
        out.append(e)
    last = conn.execute("SELECT MAX(synced_at) FROM prs").fetchone()[0]
    return {"now": now(), "synced": last or 0, "efforts": out}


# ---------------------------------------------------------------- codex review loop

CODEX_RECEIPT = "<!-- codex-review-receipt:v1 -->"
CODEX_ROUNDS = 3


def gh_items(path):
    """Every item of a paginated GitHub list endpoint, or None if gh fails."""
    out = run(["gh", "api", "--paginate", path + "?per_page=100", "--jq", ".[]"], timeout=60)
    if out is None:
        return None
    return [json.loads(line) for line in out.splitlines() if line.strip()]


def codex_state(comments, reviews):
    """(time of the latest `@codex review` request or 0, Codex's receipts oldest first).
    Findings come as a PR review, a clean pass as an issue comment; both carry the receipt marker."""
    asked = max([parse_ts(c["created_at"]) for c in comments
                 if re.match(r"\s*@codex review\b", c.get("body") or "")] or [0])
    receipts = [{"at": parse_ts(c["created_at"]), "id": None, "body": c["body"],
                 "clean": "find any major issues" in c["body"]}
                for c in comments if CODEX_RECEIPT in (c.get("body") or "")]
    receipts += [{"at": parse_ts(r["submitted_at"]), "id": r["id"], "body": r["body"], "clean": False}
                 for r in reviews if CODEX_RECEIPT in (r.get("body") or "") and r.get("submitted_at")]
    return asked, sorted(receipts, key=lambda r: r["at"])


def codex_finding(c):
    """One inline Codex comment as plain text: [P1] path:line, then the body without badges."""
    body = c.get("body") or ""
    prio = re.search(r"!\[(P\d) Badge\]", body)
    body = re.sub(r"<sub>|</sub>|!\[[^\]]*\]\([^)]*\)", "", body)
    body = re.sub(r"Useful\? React with .*|<!--.*?-->", "", body)
    body = re.sub(r"^\s*\*\*\s*(.+?)\*\*", r"\1:", body, count=1)   # the bold title line
    body = re.sub(r"\n{3,}", "\n\n", body).strip()
    return "- %s%s:%s\n  %s" % ("[%s] " % prio.group(1) if prio else "", c.get("path"),
                                 c.get("line") or c.get("original_line") or "?",
                                 clip(body, 1200).replace("\n", "\n  "))


def cmd_codex_wait(args):
    if args.pr:
        url = args.pr
    else:
        conn = db()
        e = current_effort(conn, args)
        row = conn.execute("SELECT url FROM prs WHERE effort_id = ? ORDER BY state IN ('OPEN', '') DESC, "
                           "number DESC LIMIT 1", (e["id"],)).fetchone()
        if not row:
            sys.exit("gj: no PR linked to #%d; pass the PR url" % e["id"])
        url = row["url"]
    m = PR_RE.search(url)
    if not m:
        sys.exit("gj: not a GitHub PR url: %s" % url)
    repo, num = m.group(1), m.group(2)
    if args.request and run(["gh", "pr", "comment", url, "--body", "@codex review"]) is None:
        sys.exit("gj: couldn't comment @codex review on %s" % url)
    deadline = now() + args.timeout * 60
    print("gj: waiting for Codex on %s (up to %d min)" % (url, args.timeout), flush=True)
    while True:
        comments = gh_items("repos/%s/issues/%s/comments" % (repo, num))
        reviews = gh_items("repos/%s/pulls/%s/reviews" % (repo, num))
        if comments is not None and reviews is not None:
            asked, receipts = codex_state(comments, reviews)
            new = [r for r in receipts if r["at"] > asked]
            if new:
                r = new[-1]
                rounds = sum(1 for x in receipts if not x["clean"])
                n = receipts.index(r) + 1
                if r["clean"]:
                    print("Codex review %d on %s: no major issues. The loop is done." % (n, url))
                    return
                found = gh_items("repos/%s/pulls/%s/reviews/%s/comments" % (repo, num, r["id"])) or []
                print("Codex review %d on %s: %d finding(s). Rounds with findings: %d of %d.\n"
                      % (n, url, len(found), rounds, CODEX_ROUNDS))
                print("\n".join(codex_finding(c) for c in found) or "(no inline comments; see the PR)")
                if rounds >= CODEX_ROUNDS:
                    print("\nThat was the last round: fix what is real, then `gj stage human`.")
                return
        state = run(["gh", "pr", "view", url, "--json", "state", "--jq", ".state"])
        if state in ("MERGED", "CLOSED"):
            print("gj: %s is %s; nothing to wait for." % (url, state.lower()))
            sys.exit(3)
        if now() > deadline:
            print("gj: no Codex review on %s after %d min. Tell the user; don't keep waiting." % (url, args.timeout))
            sys.exit(2)
        time.sleep(args.interval)


