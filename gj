**In progress**, then one bullet listing quiet efforts by title only.

Be short and concrete. Use only facts in the input. Never invent status or results.""",
    "weekly": """You write a developer's weekly summary of the software work their AI coding agents did.
The input lists every tracked effort: what happened in the last 7 days, and what is still open now.
Stay high level: group work into themes (use epics where given) instead of listing every PR.
Write Markdown with exactly these three sections and nothing before or after:

## Executive summary
Three or four short sentences of plain prose, under 90 words: the week's main outcomes and what is stuck.
No bullets, no lists of PRs.

## Done
One bullet per theme: what shipped and why it matters, with the key PRs as links like [repo#123](url).

## Still open
One bullet per theme or effort still in flight: where it stands and what it is waiting on.
Lead with what needs the developer. Put quiet efforts in one final bullet, titles only.

Be short and concrete. Use only facts in the input. Never invent status or results.""",
}
_summary_lock = threading.Lock()


def summary_span(kind, t=None):
    """(start, end, label): the previous workday for daily (Friday through Sunday on a Monday),
    the last 7 days for weekly."""
    t = t or now()
    if kind == "weekly":
        return t - 7 * 86400, t, "last 7 days"
    today = datetime.fromtimestamp(t).date()   # calendar days, so DST changes don't shift midnight
    day = today - timedelta(days=1)
    while day.weekday() >= 5:   # back over the weekend to Friday
        day -= timedelta(days=1)
    label = day.strftime("%a %b %-d")
    if (today - day).days > 1:
        label += " through %s" % (today - timedelta(days=1)).strftime("%a %b %-d")
    midnight = lambda d: datetime.combine(d, datetime.min.time()).timestamp()
    return midnight(day), midnight(today), label


def summary_digest(conn, start, end, efforts=None):
    """Plain-text facts for the model: what changed in [start, end), and what is open now."""
    efforts = board(conn)["efforts"] if efforts is None else efforts
    within = lambda ts: start <= (ts or 0) < end
    done, open_, quiet = [], [], []
    for e in efforts:
        closed = e["status"] in ("done", "dropped")
        moved = [p for p in e["prs"] if p["state"] in ("MERGED", "CLOSED") and within(closed_at(p))]
        active = moved or any(within(x) for x in (e["created_at"], e["updated_at"], e.get("stage_at"),
                                                   (e.get("live") or {}).get("seen")))
        if closed and not (within(e["updated_at"]) or moved):
            continue
        if not closed and e.get("lane") == "idle" and not active:
            quiet.append("#%d %s" % (e["id"], e["title"]))
            continue
        lines = ["### #%d %s%s" % (e["id"], e["title"], " [epic: %s]" % e["epic"] if e["epic"] else "")]
        lines.append("status: %s; stage: %s; board column: %s%s; active in window: %s" % (
            e["status"], e.get("stage") or "-", e.get("lane") or "-",
            " (%s)" % e["why"] if e.get("why") else "", "yes" if active else "no"))
        if e["prompt"]:
            lines.append("request: " + clip(e["prompt"], 400))
        if e["note"]:
            lines.append("note: " + clip(e["note"], 300))
        earlier = [p for p in e["prs"] if p["state"] in ("MERGED", "CLOSED") and p not in moved]
        if earlier:
            lines.append("%d earlier PRs already merged or closed" % len(earlier))
        for p in e["prs"]:
            if p in earlier:
                continue
            bits = [p["state"] or "?"]
            if p in moved:
                bits.append("%s in window" % p["state"].lower())
            bits += [x for x in (p["review"], p["checks"] and "checks " + p["checks"],
                                 p.get("auto_merge") and "auto-merge on") if x]
            lines.append("PR %s#%d %s (%s) %s" % (p["repo"].split("/")[-1], p["number"], json.dumps(p["title"]),
                                                  ", ".join(bits), p["url"]))
        doing = (e.get("live") or {}).get("doing")
        if doing:
            lines.append("agent's latest message: " + clip(doing, 400))
        (done if closed or (moved and not open_prs_of(e)) else open_).append("\n".join(lines))
    out = ["# Finished in the window", *(done or ["(none)"]), "", "# Still open now", *(open_ or ["(none)"])]
    if quiet:
        out += ["", "# Quiet (open, no activity in the window)", *quiet]
    return "\n".join(out)


def closed_at(p):
    return p.get("closed_at") or p["pr_updated_at"]   # older rows synced before closedAt was stored


def open_prs_of(e):
    return [p for p in e["prs"] if p["state"] in ("OPEN", "")]


def ask_claude(system, text, model=SUMMARY_MODEL):
    """One tool-less, settings-free `claude -p` call (uses the Claude Code login, no API key)."""
    cmd = ["claude", "-p", "--model", model, "--tools", "", "--no-session-persistence",
           "--setting-sources", "", "--strict-mcp-config", "--system-prompt", system]
    try:
        r = subprocess.run(cmd, input=text, capture_output=True, text=True, timeout=600,
                           cwd=str(Path(DB_PATH).parent))
    except (OSError, subprocess.TimeoutExpired) as ex:
        raise RuntimeError("claude failed: %s" % ex)
    if r.returncode or not r.stdout.strip():
        raise RuntimeError("claude failed: " + clip((r.stderr or r.stdout).strip(), 300))
    return r.stdout.strip()


def latest_summary(conn, kind):
    if kind == "daily":
        q = "SELECT * FROM summaries WHERE kind = 'daily' AND day = ?"
        row = conn.execute(q, (datetime.now().date().isoformat(),)).fetchone()
    else:
        row = conn.execute("SELECT * FROM summaries WHERE kind = ? ORDER BY created_at DESC LIMIT 1",
                           (kind,)).fetchone()
    return dict(row) if row else None


def make_summary(conn, kind, ask=ask_claude):
    """Daily runs at most once a day (later calls get the saved copy); weekly runs every time."""
    with _summary_lock:
        if kind == "daily":
            have = latest_summary(conn, kind)
            if have:
                return have
        start, end, label = summary_span(kind)
        digest = "Window: %s\n\n%s" % (label, summary_digest(conn, start, end))
        text = ask(SUMMARY_PROMPTS[kind], digest)
        row = {"kind": kind, "day": datetime.now().date().isoformat(), "text": text, "span": label,
               "created_at": now()}
        conn.execute("INSERT OR REPLACE INTO summaries(kind, day, text, span, created_at) "
                     "VALUES (:kind, :day, :text, :span, :created_at)", row)
        conn.commit()
        return row


def cmd_summary(args):
    conn = db()
    if args.digest:
        start, end, label = summary_span(args.kind)
        print("Window: %s\n\n%s" % (label, summary_digest(conn, start, end)))
        return
    print(make_summary(conn, args.kind)["text"])


